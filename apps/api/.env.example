HASEEF_ENV=development
HASEEF_DATABASE_URL_APP=postgresql+psycopg://haseef_app:dev@localhost:5432/haseef
HASEEF_DATABASE_URL_PLATFORM=postgresql+psycopg://haseef_platform:dev@localhost:5432/haseef
HASEEF_REDIS_URL=redis://localhost:6379/0
HASEEF_JWT_SECRET=dev-only-secret-change-me-0123456789

# console = طباعة الرسائل بدل إرسالها. للإرسال الفعلي: unifonic أو meta
HASEEF_WHATSAPP_PROVIDER=console
# HASEEF_UNIFONIC_APP_SID=
# HASEEF_UNIFONIC_SENDER=
# HASEEF_META_PHONE_NUMBER_ID=
# HASEEF_META_ACCESS_TOKEN=

# الذكاء الاصطناعي معطّل حتى يُعتمد مزوّد داخل المملكة (الوثيقة §1.1)
HASEEF_LLM_PROVIDER=disabled
# HASEEF_LLM_BASE_URL=
# HASEEF_LLM_API_KEY=
# HASEEF_LLM_MODEL=
# HASEEF_LLM_REGION=
