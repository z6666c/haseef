# حصيف — متغيرات الإنتاج. انسخه إلى deploy/.env واملأه على الخادم فقط.
# لا يُرفع deploy/.env إلى المستودع أبداً (مستثنى في .gitignore).
# لتوليد الأسرار تلقائياً:  deploy/scripts/gen-secrets.sh > deploy/.env  ثم أكمل الباقي.

# ---------------------------------------------------------------- النطاق
HASEEF_DOMAIN=haseef.sa
ACME_EMAIL=ops@haseef.sa
# حصر غرفة العمليات في عناوين محددة (مفصولة بمسافة). الافتراضي: مفتوحة مع تسجيل الدخول.
# ADMIN_ALLOW_IPS=203.0.113.10/32 198.51.100.0/24
HASEEF_VERSION=latest

# ---------------------------------------------------------------- الأسرار (تُولَّد عشوائياً)
POSTGRES_PASSWORD=
HASEEF_DB_APP_PASSWORD=
HASEEF_DB_PLATFORM_PASSWORD=
HASEEF_JWT_SECRET=

# ---------------------------------------------------------------- التنبيهات
HASEEF_ALERT_SEND_HOUR=9
# console = تسجيل الرسائل دون إرسال حتى تُعتمد القوالب. ثم: unifonic أو meta
HASEEF_WHATSAPP_PROVIDER=console
# HASEEF_UNIFONIC_APP_SID=
# HASEEF_UNIFONIC_SENDER=
# HASEEF_META_PHONE_NUMBER_ID=
# HASEEF_META_ACCESS_TOKEN=

# ---------------------------------------------------------------- الذكاء الاصطناعي
# يبقى معطلاً حتى اعتماد مزوّد داخل المملكة؛ تفعيله يتطلب HASEEF_LLM_REGION.
HASEEF_LLM_PROVIDER=disabled
# HASEEF_LLM_BASE_URL=
# HASEEF_LLM_API_KEY=
# HASEEF_LLM_MODEL=
# HASEEF_LLM_REGION=

# ---------------------------------------------------------------- النسخ الاحتياطي
BACKUP_KEEP_DAYS=14
# نسخة خارج الخادم (تخزين كائنات متوافق مع S3 داخل المملكة). اتركه فارغاً للاكتفاء بالنسخ المحلية.
# BACKUP_S3_ENDPOINT=https://
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
